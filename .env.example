# ── KayCare HMS Backend Environment Variables ────────────────────────────────
# Copy this file to .env or configure in your deployment platform (e.g. Render)

# Database Connection (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Database=KayCareDb;Username=postgres;Password=postgres;

# JWT Authentication Configuration (Key must be at least 32 characters long)
Jwt__Key=your-super-secret-jwt-key-minimum-32-chars-long!
Jwt__Issuer=KayCare
Jwt__Audience=KayCare
Jwt__ExpiryHours=8

# Supabase Storage Configuration (Blob/File Storage)
Supabase__Url=https://your-supabase-project-id.supabase.co
Supabase__ServiceKey=your-supabase-service-role-key

# CORS Allowed Origins
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=https://kaycare-hms-frontend.onrender.com

# AI Medical Copilot Features (Optional - Google Gemini API)
Gemini__ApiKey=your-gemini-api-key

# HL7 Integrations Security Key
Hl7__WebhookApiKey=your-hl7-webhook-secret-key
